# Copy to backend/.env and fill in. Never commit .env.

# Postgres connection string.
#  Neon / Supabase:  postgres://USER:PASSWORD@HOST/DB?sslmode=require
#  Docker (docker-compose.yml, host port 5433): postgres://sulthan:sulthan@localhost:5433/sulthan_holidays
#  Local apt install (port 5432):               postgres://sulthan:sulthan@localhost:5432/sulthan_holidays
DATABASE_URL=postgres://sulthan:sulthan@localhost:5433/sulthan_holidays

# Random string of at least 32 characters (`openssl rand -hex 32`). Signs login tokens.
# The API refuses to start if this is short or still a placeholder. ./run.sh fills it in for you.
JWT_SECRET=change-me

BIND_ADDR=0.0.0.0:8080
# Comma-separated list of website + admin origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Google sign-in: OAuth "Web" client ID from Google Cloud Console. Leave empty to disable.
GOOGLE_CLIENT_ID=

# UPI details used to build the payment QR code.
UPI_ID=
# Values containing spaces MUST be quoted, or everything after that line is silently ignored.
UPI_PAYEE="Sulthan Holidays"

# Suggested advance (% of the booking amount) shown to staff when they confirm a booking.
# Customers pay only this advance, and only after staff confirm. Staff can change it per booking.
ADVANCE_PERCENT=25

# Admin account, created/updated at startup. Password: at least 8 characters, not the placeholder
# (the API refuses to start otherwise). Use a long unique passphrase in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
